{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": false,
		"esModuleInterop": true,
		"lib": ["dom", "es5", "scripthost", "es2017"]
	},
	"include": ["**/*.ts"]
}
